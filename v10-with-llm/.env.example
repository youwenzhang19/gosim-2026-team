# Official / local OpenAI-compatible LLM injection (never commit real keys).
# Copy to .env for local runs only; platform injects the same names at eval time.
#
# OPENAI_API_KEY=sk-...
# KIMI_API_KEY=           # alternate bearer; used if OPENAI_API_KEY is empty
# OPENAI_BASE_URL=https://api.kimi.com/coding/v1
# OPENAI_MODEL=k3
#
# Force rules-only (platform 「本次不提供模型」 / --no-model):
# OBSERVER_MODEL_DISABLED=1
#
# Optional v8 extras (default on when LLM is enabled):
# V8_FORECAST_ENABLED=1
# V8_POLICY_ENABLED=1
# V8_POLICY_APPLY=1
# PRO_LOG_READER=1
# PRO_MODEL_WAIT_MAX=20
